# ---- App ----
FLASK_SECRET_KEY=change_me
TIMEZONE=America/Lima
BASE_URL=http://localhost:5000
SCREENSHOT_DIR=static/screenshots

# ---- Email (SMTP) ----
# Para Gmail: usa una "App Password" (https://myaccount.google.com/apppasswords)
# Para cPanel con Exim local: SMTP_HOST=localhost, SMTP_PORT=25, sin USER/PASS
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=app_password
FROM_EMAIL=Monitor Web <you@example.com>
TO_EMAILS=ops@example.com, soporte@example.com
