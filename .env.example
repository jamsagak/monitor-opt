# ---- App ----
FLASK_SECRET_KEY=change_me
TIMEZONE=America/Lima
BASE_URL=http://localhost:5000
SCREENSHOT_DIR=static/screenshots

# ---- Email (SMTP) ----
# Brevo (recomendado en cPanel — usa API HTTP para evitar que Exim intercepte SMTP):
#   SMTP_HOST=smtp-relay.brevo.com, SMTP_USER=tu@email.com
#   SMTP_PASS=xsmtpsib-... (clave SMTP de Brevo, Settings > SMTP & API)
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_PASS=app_password
# cPanel Exim local: SMTP_HOST=localhost, SMTP_PORT=25, sin USER/PASS
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=xsmtpsib-your-brevo-smtp-key
FROM_EMAIL=Monitor Web <you@example.com>
TO_EMAILS=ops@example.com, soporte@example.com
